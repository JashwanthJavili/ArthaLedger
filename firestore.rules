rules_version = '2';

// Each signed-in person can reach only their own data. Everything else
// (feedback, admin data) is read and written by the server, never the browser.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // users/{uid} and everything inside it: projects, books, entries,
    // templates, groups, push tokens, PIN guards
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Reminder settings, one document per person (the server reads all of them)
    match /reminders/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Anything else is closed to the browser
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
